# Python virtual environment
.venv/
venv/
ENV/

# Python byte-code and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# User uploads & processed data (preserve privacy and provenance)
data/uploads/*
!data/uploads/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Outputs generated during runs
outputs/schedules/*
!outputs/schedules/.gitkeep
outputs/metrics/*
!outputs/metrics/.gitkeep
outputs/figures/*
!outputs/figures/.gitkeep
outputs/reports/*
!outputs/reports/.gitkeep

# Logs
logs/*
!logs/.gitkeep

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
